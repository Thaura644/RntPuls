# Database
DATABASE_URL=postgres://rentpulse:secure_password@localhost:5432/rentpulse?sslmode=disable
DB_PASSWORD=secure_password

# Auth
JWT_SECRET=generate-a-long-random-secret-with-openssl-rand-base64-32
JWT_EXPIRY_HOURS=1
BCRYPT_COST=12

# CORS / Origins
FRONTEND_ORIGIN=http://localhost:5173
APP_ENV=development

# Twilio (SMS / WhatsApp reminders)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_SMS=
TWILIO_FROM_WHATSAPP=

# M-Pesa Daraja API (payment verification)
MPESA_BASE_URL=https://sandbox.safaricom.co.ke
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORT_CODE=

# File uploads
UPLOAD_DIR=uploads

# Public-facing URL (used in tenant portal links)
PUBLIC_BASE_URL=http://localhost:8080

# Server
PORT=8080
